# Server only: /etc/finite/backend.env, mode 0600. Do not put real keys in Git.
OPENAI_API_KEY=
# Enable AI only after explicit server approval; preserve the existing ledger.
FINITE_AI_BUDGET_USD=15
FINITE_DATA_DIR=/data
FINITE_ALLOWED_ORIGINS=https://finite.akashanil.dev
FINITE_SECURE_COOKIES=true
FINITE_SCHEDULER_ENABLED=false
FINITE_FAST_MODEL=gpt-6-luna
FINITE_SMART_MODEL=gpt-6.1-sol
FINITE_EMBED_MODEL=text-embedding-3-small
