# Copy to backend/.env. Without OPENAI_API_KEY the app runs in extractive (no-AI) mode.
OPENAI_API_KEY=
# Optional overrides
FINITE_FAST_MODEL=gpt-6-luna
FINITE_SMART_MODEL=gpt-6.1-sol
FINITE_EMBED_MODEL=text-embedding-3-small
FINITE_INGEST_INTERVAL_MIN=60
# Accounts: dev origins only; use exact HTTPS origin and Secure cookies in production.
FINITE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FINITE_SECURE_COOKIES=false
FINITE_SCHEDULER_ENABLED=true
# Optional persistent state path (default: backend/data)
# FINITE_DATA_DIR=/data
